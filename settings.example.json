{
  "default_provider": "example",
  "default_model_tier": "default",

  "classifier_provider": "example",
  "classifier_model_name": "your-fast-model-id",

  "providers": [
    {
      "provider_name": "example",
      "provider_type": "openai",
      "base_url": "https://your-gateway.example.com/v1",
      "api_key": "sk-REPLACE_ME",

      "default_model_name": "your-model-id",
      "deep_reasoning_model_name": "your-reasoning-model-id",
      "balanced_model_name": "your-balanced-model-id",
      "fast_model_name": "your-fast-model-id",

      "max_tokens": 8192,
      "temperature": 0.6,
      "context_window": 200000,
      "max_output_tokens": null,
      "capability_note": "瘦网关（/models 只有 id/object/created/owned_by/supported_endpoint_types，例如 ipsa-thor）不会返回 max_output_tokens、vision、tools、reasoning。留空表示未声明：neo 只补网关明确给出的值，补不到就保持「未探测到」，需要在这里手写。max_output_tokens 是模型能力上限，不是上面的请求预算 max_tokens。手写 false 也算已声明，不会被覆盖。",

      "vision": false,
      "tools": true,
      "reasoning": false
    }
  ],

  "model_routes": {
    "default": { "provider": "example", "model": "your-model-id" },
    "balanced": { "provider": "example", "model": "your-balanced-model-id" },
    "fast": { "provider": "example", "model": "your-fast-model-id" },
    "deep_reasoning": {
      "provider": "example",
      "model": "your-reasoning-model-id",
      "fallback_allowed": true
    }
  },

  "compact_threshold": 0.75,
  "max_tool_iterations": 80,
  "tool_output_limit": 30000,

  "skills_extra_paths": [],

  "shell": {
    "path": null,
    "login": true,
    "args": null
  },

  "env": {
    "enabled": true,
    "probe_ttl_hours": 12,
    "models_probe_timeout_ms": 5000,
    "env_note": "models_probe_timeout_ms 是 /models 能力探测超时（毫秒）。企业网关冷启动偏慢时可以再调大，默认 5000。",
    "prompt": true,
    "wiki_page": true
  },

  "retry": {
    "max_attempts": 3,
    "base_delay_ms": 500,
    "connect_timeout_ms": 30000,
    "stream_idle_timeout_ms": 120000
  },

  "parallel_tool_calls": "readonly",
  "parallel_tool_calls_note": "工具并行策略。readonly（默认）= 请求体 parallel_tool_calls=true，本地只把连续的可并行只读工具（read_file/list_dir/glob/grep/web_fetch/web_search/wiki_search）并行执行，写工具与 shell 仍是串行屏障；off = 请求体 false 且本地一律串行（瘦网关不认该字段或排障时用）。也接受布尔值：true=readonly，false=off。",

  "theme": "matrix",
  "show_reasoning": true,
  "toolcall_info_details": false,

  "cross_session_inbound": "auto",
  "cross_session_auto_turn_limit": 20,
  "cross_session_heartbeat_ms": 15000,
  "cross_session_dead_after_ms": 120000,
  "cross_session_progress_timeout_ms": 300000,
  "cross_session_watchdog_interval_s": 120,

  "memory": {
    "enabled": true,
    "user_wiki_dir": "~/.neo/wiki",
    "journal_dir": "~/.neo/memory/journal",
    "auto_recall": {
      "enabled": true,
      "max_tokens": 900,
      "project_pages": 2,
      "user_pages": 1
    },
    "auto_capture": {
      "enabled": true,
      "mode": "boundary",
      "model_tier": "fast",
      "max_ops_per_turn": 2,
      "max_pages_per_session": 8,
      "min_confidence": 0.65,
      "min_inferred_confidence": 0.75,
      "journal_retention_days": 7,
      "flush_timeout_ms": 3000
    },
    "quiet": false
  }
}
