node_modules/
settings.json
*.log
.DS_Store
.neo-session/

# 技能：全局技能库在 home 目录下，本就不在任何 git 仓库里。
# 这里只声明不提交全局库；项目 skills/<name> 软链由使用者自行 ignore
# —— gitignore 无法区分 symlink 与真目录，写 skills/ 会连项目私有技能一起 ignore。
.neo/skills/

# neo 会话导出
neo-session.json

# wiki 派生物：能从 wiki 重新生成，不进版本控制
.neo/wiki/outputs/

# 记忆写锁目录（运行时状态）
.neo/wiki/.locks/

# git worktree 工作区（每个都是独立检出，不应被追踪）
.worktrees/

# 构建产物
dist/
build/
out/
*.tsbuildinfo
.cache/

# 项目根 AGENTS.md:由 /init 生成的本地记忆,不入库(用户决定 2026-10-16)
/AGENTS.md
