{
  "name": "neo",
  "version": "0.4.97",
  "private": true,
  "type": "module",
  "description": "A Matrix-themed CLI coding harness powered by an OpenAI-compatible LLM endpoint.",
  "bin": {
    "neo": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "neo": "bun run src/index.ts",
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "e2e": "bun run scripts/pty-e2e.ts",
    "verify": "bash scripts/verify.sh",
    "preinstall": "bun run scripts/compat-pin.ts",
    "compat:check": "bun run scripts/compat-pin.ts",
    "compat:install": "bun run scripts/compat-pin.ts && bun install --frozen-lockfile"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "@neo/core-compat": "file:vendor/neo-core-compat-v1.tgz",
    "ajv": "8.17.1"
  }
}
